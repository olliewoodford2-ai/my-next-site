<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>404 — Pear</title>
    <style>
      @font-face {
        font-family: "Flecha S";
        src: url("/fonts/FlechaS-Light.woff2?v=2") format("woff2");
        font-weight: 300;
        font-display: swap;
      }
      @font-face {
        font-family: "GT Standard L";
        src: url("/fonts/GTStandardL-Regular.woff2") format("woff2");
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: "GT Standard L";
        src: url("/fonts/GTStandardL-Medium.woff2") format("woff2");
        font-weight: 500;
        font-display: swap;
      }
      @font-face {
        font-family: "GT Standard Mono";
        src: url("/fonts/GTStandardMono-Regular.woff2") format("woff2");
        font-weight: 400;
        font-display: swap;
      }
      * { margin: 0; box-sizing: border-box; }
      html, body { height: 100%; }
      body {
        position: relative;
        overflow: hidden;
        background: #f2f1ed;
        font-family: "GT Standard L", system-ui, sans-serif;
        /* per-art variables, set by the roulette script */
        --fg: #1d1c19;
        --fg-soft: rgb(29 28 25 / 0.62);
        --chip-bg: #1d1c19;
        --chip-fg: #f2f1ed;
        --content-top: 30%;
        --content-top-m: 10%;
        --img-pos: 50% 50%;
        --img-pos-m: 50% 50%;
        --shadow: none;
        --rule: rgb(29 28 25 / 0.16);
        --cross: rgb(29 28 25 / 0.42);
      }
      body.tone-paper {
        --fg: #f2f1ed;
        --fg-soft: rgb(242 241 237 / 0.72);
        --chip-bg: #f2f1ed;
        --chip-fg: #1d1c19;
        --shadow: 0 1px 22px rgb(11 10 9 / 0.35);
        --rule: rgb(242 241 237 / 0.3);
        --cross: rgb(242 241 237 / 0.58);
      }

      /* The hero's registration grid, occluded per-plate by the artwork */
      .grid { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }

      .art {
        position: absolute;
        inset: 0;
        height: 100%;
        width: 100%;
        object-fit: cover;
        object-position: var(--img-pos);
        user-select: none;
        -webkit-user-drag: none;
        pointer-events: none;
      }
      @media (prefers-reduced-motion: no-preference) {
        .art { animation: settle 2.4s cubic-bezier(0.22, 1, 0.36, 1) both; }
        .content > * { animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both; }
        .content > * + * { animation-delay: 0.4s; }
        .content > .sub { animation-delay: 0.5s; }
        .content > .cta { animation-delay: 0.65s; }
        @keyframes settle { from { transform: scale(1.035); } to { transform: scale(1); } }
        @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
      }

      /* Mobile-only paper scrim for busy grounds (florals, archive) */
      .scrim { position: absolute; inset: 0; pointer-events: none; display: none; }

      /* The printer's seal, home link — same cell as the site */
      .seal {
        position: absolute;
        left: 0; top: 0;
        z-index: 2;
        width: max(6%, 3.25rem);
        height: max(9%, 2.875rem);
        background: #1d1c19;
        display: grid;
        place-items: center;
      }
      .seal svg { height: clamp(1.25rem, 2.2vw, 2rem); width: auto; }

      .content {
        position: absolute;
        z-index: 1;
        top: var(--content-top);
        left: 0; right: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0 6vw;
        color: var(--fg);
      }
      body.align-left .content {
        left: 7vw; right: auto;
        max-width: 44ch;
        align-items: flex-start;
        text-align: left;
        padding: 0;
      }
      .label {
        font-family: "GT Standard Mono", ui-monospace, monospace;
        font-size: 0.6875rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--fg-soft);
        text-shadow: var(--shadow);
      }
      h1 {
        margin-top: 1.1rem;
        font-family: "Flecha S", "Source Serif 4", Georgia, serif;
        font-weight: 300;
        font-size: clamp(2.125rem, 4.6vw, 4rem);
        letter-spacing: -0.018em;
        line-height: 1.1;
        text-shadow: var(--shadow);
        text-wrap: balance;
      }
      .sub {
        margin-top: 0.9rem;
        font-size: clamp(0.875rem, 1.05vw, 1rem);
        color: var(--fg-soft);
        text-shadow: var(--shadow);
      }
      .cta {
        display: inline-flex;
        align-items: center;
        gap: 0.6em;
        margin-top: 2rem;
        padding: 0.8rem 1.5rem;
        background: var(--chip-bg);
        color: var(--chip-fg);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
      }
      .cta .arrow { transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
      .cta:hover .arrow { transform: translateX(0.3em); }

      @media (max-width: 640px) {
        .content,
        body.align-left .content {
          top: var(--content-top-m);
          left: 0; right: 0;
          max-width: none;
          align-items: center;
          text-align: center;
          padding: 0 7vw;
        }
        .art { object-position: var(--img-pos-m); }
        body.scrim-paper-top .scrim {
          display: block;
          background: linear-gradient(to bottom, rgb(242 241 237 / 0.92) 0%, rgb(242 241 237 / 0.55) 26%, transparent 48%);
        }
        body.scrim-ink-top .scrim {
          display: block;
          background: linear-gradient(to bottom, rgb(11 10 9 / 0.55) 0%, rgb(11 10 9 / 0.25) 26%, transparent 48%);
        }
      }
    </style>
  </head>
  <body>
    <img id="art" class="art" alt="" decoding="async" fetchpriority="high" draggable="false" />
    <div class="scrim" aria-hidden="true"></div>
    <canvas class="grid" id="grid" aria-hidden="true"></canvas>
    <a class="seal" href="/" aria-label="Back to pear.no">
      <svg viewBox="0 0 305 415" fill="none" aria-hidden="true">
        <path
          d="M153.19 22.53C168.21 23.03 182.32 28.8 193.13 38.92C202.3 47.51 208.57 58.46 211.23 70.6C220.52 112.92 237.69 155.75 262.27 197.92C273.65 217.44 279.66 239.79 279.66 262.54C279.66 296.89 266.29 329.18 242.01 353.46C217.73 377.74 185.45 391.11 151.13 391.12L149.08 391.11C80.4 390.15 23.57 333.39 22.51 264.58C22.14 240.37 28.5 216.71 40.91 196.17C63.74 158.4 80.6 116 91.02 70.15C93.73 58.21 99.95 47.41 109.01 38.92C120.33 28.33 135.27 22.5 151.08 22.5C151.79 22.5 152.49 22.51 153.19 22.53Z"
          stroke="#f2f1ed" stroke-width="40" stroke-miterlimit="10" stroke-linecap="round"
        />
      </svg>
    </a>
    <main class="content">
      <p class="label">404</p>
      <h1>This page doesn&rsquo;t appear.</h1>
      <p class="sub">There&rsquo;s nothing at this address.</p>
      <a class="cta" href="/">Back to the front page <span class="arrow">→</span></a>
    </main>
    <script>
      // The 404 roulette: every miss lands on one of the commissioned
      // plates, each with its own type tone, anchor zone, and mobile crop.
      // Preview any of them with ?art=<id>.
      // Each plate names a sample point (image-normalized x,y) on its flat
      // ground and a color tolerance: the registration grid prints only
      // where the artwork stays close to that ground, so figures, props
      // and drapery occlude the rules — same trick as the hero, computed
      // once per load because the plates are still.
      const ARTS = [
        { id: "meadow",   tone: "ink",   align: "center", top: "22%", topM: "9%",  pos: "50% 50%", posM: "46% 62%", g: [0.15, 0.22], tol: 60,
          alt: "A lone wanderer in white where the footpath fades out of a wildflower meadow, under towering halftone clouds" },
        { id: "florals",  tone: "ink",   align: "left",   top: "9%",  topM: "7%",  pos: "50% 50%", posM: "62% 26%", scrim: "paper-top", g: [0.07, 0.1], tol: 48,
          alt: "A figure in a white ruffled collar among oil-painted peonies, eyes hidden behind a rainbow glitch smear" },
        { id: "gallery",  tone: "ink",   align: "left",   top: "11%", topM: "7%",  pos: "50% 50%", posM: "50% 42%", g: [0.15, 0.16], tol: 34,
          alt: "A scholar in a green robe before a gilded frame holding nothing but halftone static, in a marble gallery" },
        { id: "scales",   tone: "paper", align: "left",   top: "13%", topM: "8%",  pos: "50% 50%", posM: "36% 50%", g: [0.5, 0.1], tol: 55,
          alt: "A woman leaning on red marble, studying a golden balance scale weighing a weightless halftone pear" },
        { id: "sheet",    tone: "ink",   align: "center", top: "13%", topM: "9%",  pos: "50% 50%", posM: "50% 50%", g: [0.5, 0.07], tol: 32,
          alt: "Two hands holding the ends of a sheet of paper whose middle has dissolved into falling halftone dots" },
        { id: "curtains", tone: "paper", align: "center", top: "32%", topM: "28%", pos: "50% 50%", posM: "50% 50%", g: [0.5, 0.32], tol: 50,
          alt: "Two halftone curtains drawn apart onto an empty sage-green stage" },
        { id: "columns",  tone: "paper", align: "center", top: "10%", topM: "7%",  pos: "50% 50%", posM: "50% 55%", g: [0.5, 0.1], tol: 50,
          alt: "Two muses behind marble columns regard an empty pedestal and the halftone ghost of a pear" },
        { id: "archive",  tone: "ink",   align: "left",   top: "28%", topM: "7%",  pos: "50% 50%", posM: "72% 42%", scrim: "paper-top", g: [0.1, 0.45], tol: 26,
          alt: "A woman on a library ladder reaching into the one empty slot of an immense archive of paper" },
      ];
      const wanted = new URLSearchParams(location.search).get("art");
      const art = ARTS.find((a) => a.id === wanted) || ARTS[Math.floor(Math.random() * ARTS.length)];
      const body = document.body;
      body.classList.add(`tone-${art.tone}`, `align-${art.align}`);
      if (art.scrim) body.classList.add(`scrim-${art.scrim}`);
      body.style.setProperty("--content-top", art.top);
      body.style.setProperty("--content-top-m", art.topM);
      body.style.setProperty("--img-pos", art.pos);
      body.style.setProperty("--img-pos-m", art.posM);
      const img = document.getElementById("art");
      img.alt = art.alt;
      img.src = `/art/404/${art.id}.jpg`;

      // ---- the occluded registration grid ----
      const grid = document.getElementById("grid");
      const gctx = grid.getContext("2d");
      const maskCanvas = document.createElement("canvas");

      function buildMask() {
        const iw = img.naturalWidth, ih = img.naturalHeight;
        const mw = 240, mh = Math.max(1, Math.round((mw * ih) / iw));
        maskCanvas.width = mw;
        maskCanvas.height = mh;
        const mctx = maskCanvas.getContext("2d", { willReadFrequently: true });
        mctx.drawImage(img, 0, 0, mw, mh);
        const data = mctx.getImageData(0, 0, mw, mh);
        const d = data.data;
        const gi = (Math.round(art.g[1] * (mh - 1)) * mw + Math.round(art.g[0] * (mw - 1))) * 4;
        const gr = d[gi], gg = d[gi + 1], gb = d[gi + 2];
        const tol = art.tol, fade = tol * 0.6;
        for (let i = 0; i < d.length; i += 4) {
          const dist = Math.hypot(d[i] - gr, d[i + 1] - gg, d[i + 2] - gb);
          d[i + 3] = dist <= tol ? 255 : dist >= tol + fade ? 0 : Math.round(255 * (1 - (dist - tol) / fade));
        }
        mctx.putImageData(data, 0, 0);
      }

      function printGrid() {
        const w = innerWidth, h = innerHeight;
        const dpr = Math.min(devicePixelRatio || 1, 2);
        grid.width = Math.round(w * dpr);
        grid.height = Math.round(h * dpr);
        gctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        gctx.clearRect(0, 0, w, h);
        const paper = art.tone === "paper";
        gctx.fillStyle = paper ? "rgba(242,241,237,0.32)" : "rgba(29,28,25,0.17)";
        for (const x of [0.06, 0.93]) gctx.fillRect(Math.round(x * w), 0, 1, h);
        for (const y of [0.09, 0.6, 0.85]) gctx.fillRect(0, Math.round(y * h), w, 1);
        gctx.fillStyle = paper ? "rgba(242,241,237,0.6)" : "rgba(29,28,25,0.44)";
        for (const [cx, cy] of [[0.06, 0.09], [0.93, 0.09], [0.06, 0.6]]) {
          gctx.fillRect(Math.round(cx * w) - 10, Math.round(cy * h), 20, 1);
          gctx.fillRect(Math.round(cx * w), Math.round(cy * h) - 10, 1, 20);
        }
        // stamp the mask through the same cover + object-position mapping
        const iw = img.naturalWidth, ih = img.naturalHeight;
        const op = getComputedStyle(img).objectPosition.split(" ").map((v) => parseFloat(v) / 100);
        const scale = Math.max(w / iw, h / ih);
        const dw = iw * scale, dh = ih * scale;
        gctx.globalCompositeOperation = "destination-in";
        gctx.drawImage(maskCanvas, (w - dw) * op[0], (h - dh) * op[1], dw, dh);
        gctx.globalCompositeOperation = "source-over";
      }

      img.decode().then(() => {
        buildMask();
        printGrid();
      }).catch(() => {});
      let rt;
      addEventListener("resize", () => {
        clearTimeout(rt);
        rt = setTimeout(() => img.naturalWidth && (buildMask(), printGrid()), 150);
      });
    </script>
  </body>
</html>
